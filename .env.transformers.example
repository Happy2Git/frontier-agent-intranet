# Transformers Serve is the lightweight local/evaluation path. For sustained
# or multi-agent production load, prefer the SGLang configuration.
TRANSFORMERS_MODEL_ID=apodex/Apodex-1.0-0.8B-SFT
TRANSFORMERS_PYTORCH_IMAGE=pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime
TRANSFORMERS_IMAGE=frontier-agent-transformers:local
TRANSFORMERS_PORT=8000

TRANSFORMERS_CONTEXT_LENGTH=32768
TRANSFORMERS_MAX_INPUT_TOKENS=28672
TRANSFORMERS_MAX_OUTPUT_TOKENS=4096

# Required only for gated/private Hugging Face repositories.
HF_TOKEN=

# Optional web tools. Intranet deployments point these at the internal search
# service; empty keeps the intranet-only policy from ever reaching the public
# defaults.
SERPER_API_KEY=
SERPER_BASE_URL=
JINA_API_KEY=
JINA_BASE_URL=
