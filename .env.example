# Required: model used by the built-in react and agent_team profiles.
# Point OPENAI_BASE_URL at the internal LLM gateway on an intranet.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional: benchmark judge/scorer endpoint. Falls back to OPENAI_* when empty.
# FrontierSearchBench's scorer takes JUDGE_API_KEY + JUDGE_BASE_URL as its
# OPENROUTER_* pair (key and URL always come from the same provider). It pins
# its own model slate, so JUDGE_MODEL does not apply to it.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=

# Optional: benchmark dataset configuration.
# HF_TOKEN is required for gated datasets such as OfficeQA and APEX.
HF_TOKEN=
# OfficeQA corpus format: parsed (default) or raw. Raw mode requires downloading
# the dataset with --raw-pdfs.
OFFICEQA_DOC_MODE=parsed
# Store large benchmark datasets outside the repository when desired.
FRONTIER_AGENT_DATASETS_DIR=

# Optional: web search and page fetching.
# Intranet deployments MUST put the internal search service here. The
# intranet-only policy (FRONTIER_AGENT_INTRANET_ONLY below, on by default)
# refuses any endpoint that resolves to a public address, and disables
# web_fetch / download_file entirely, so the search endpoint is the only
# network-backed retrieval path. The old public defaults
# (https://google.serper.dev / https://r.jina.ai) are intentionally NOT shown;
# keep them out of intranet .env files.
SERPER_API_KEY=
SERPER_BASE_URL=
JINA_API_KEY=
JINA_BASE_URL=

# Intranet network policy (fail-closed by default).
# FRONTIER_AGENT_INTRANET_ONLY=1  only private/loopback/link-local host
#   destinations are allowed; web_fetch and download_file are blocked;
#   sandbox commands run network-isolated (bwrap) or are refused; E2B is
#   disabled. Set to 0 only for an explicitly public deployment.
FRONTIER_AGENT_INTRANET_ONLY=
# Comma-separated trusted hostnames (exact match or .suffix) added to the
# built-in private allowlist. The hostname entry is still resolved and its
# addresses must be private — it is not a bypass for a public answer.
FRONTIER_AGENT_ALLOWED_NETWORK_HOSTS=
# Comma-separated enterprise CIDRs (e.g. 192.0.2.0/24) added to the built-in
# private ranges (RFC1918 + loopback + link-local + IPv6 ULA).
FRONTIER_AGENT_ALLOWED_NETWORK_CIDRS=
# Optional out-of-process protocol/telemetry layer. Defaults to off; nothing
# in this repository wires it at runtime. Set to "on" only if you explicitly
# attach an external observer layer.
FRONTIER_AGENT_TELEMETRY=

# Optional: DeepSeek-native web search fallback (Anthropic-compatible Messages
# API with the web_search_20250305 server tool). Used on the original search
# path when no SERPER_API_KEY is set; the endpoint must be private in intranet
# mode. Uses DEEPSEEK_API_KEY from above when enabled.
DEEPSEEK_SEARCH_ENABLED=
DEEPSEEK_SEARCH_BASE_URL=
DEEPSEEK_SEARCH_MODEL=
DEEPSEEK_SEARCH_MAX_USES=
DEEPSEEK_SEARCH_MAX_TOKENS=
DEEPSEEK_SEARCH_API_VERSION=

# Optional: generic Anthropic-compatible search channel (any endpoint that
# speaks the Messages API with web_search_20250305, e.g. an internal gateway).
# When enabled with a key, this channel wins over deepseek_search_* on the
# original search path. Defaults to off.
ANTHROPIC_SEARCH_ENABLED=
ANTHROPIC_SEARCH_BASE_URL=
ANTHROPIC_SEARCH_API_KEY=
ANTHROPIC_SEARCH_MODEL=
ANTHROPIC_SEARCH_MAX_USES=
ANTHROPIC_SEARCH_MAX_TOKENS=
ANTHROPIC_SEARCH_API_VERSION=

# Optional: condense long fetched pages with an OpenAI-compatible endpoint.
# Only reachable through web_fetch paths, which intranet mode disables;
# leave empty in intranet deployments. SUMMARY_LLM_BASE_URL must be the full
# chat-completions URL.
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_BASE_URL=
SUMMARY_LLM_MODEL_NAME=

# Optional: read images and image-only PDF pages. Recommended for OfficeQA;
# without it, image-based questions may lose points.
# READDOC_VISION_URL is an OpenAI-compatible base URL including /v1.
# In intranet mode the bundled parser runs offline by default; set
# FRONTIER_AGENT_ALLOW_READDOC_REMOTE=1 AND point READDOC_* at private
# endpoints to re-enable remote OCR/Vision.
READDOC_VISION_URL=
READDOC_VISION_MODEL=
READDOC_VISION_KEY=
FRONTIER_AGENT_ALLOW_READDOC_REMOTE=

# Optional: OCR scanned PDFs via POST <url>/ocr.
READDOC_OCR_URL=
READDOC_OCR_KEY=